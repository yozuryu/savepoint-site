---
// Every page: the SEO head (title, description, canonical, Open Graph, Twitter, JSON-LD), the background,
// the nav and the footer.
import '../styles/global.css';
import { TEMPLATE } from '../lib/hub';

interface Props {
    title: string;
    description: string;
    /** Shown in the nav as the current section */
    section?: 'home' | 'docs';
    ogImage?: string;
    jsonLd?: Record<string, unknown>[];
    type?: 'website' | 'article';
}
const { title, description, section = 'home', ogImage = 'assets/og.jpg', jsonLd = [], type = 'website' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(base + ogImage, Astro.site).href;
const home = new URL(base, Astro.site).href;
const ld = [
    { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Savepoint', url: home },
    ...jsonLd.map(x => ({ '@context': 'https://schema.org', ...x })),
];
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="theme-color" content="#0b0f15">
    <meta name="color-scheme" content="dark">
    <meta property="og:site_name" content="Savepoint">
    <meta property="og:type" content={type}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1600">
    <meta property="og:image:height" content="900">
    <meta property="og:image:alt" content="Savepoint: your RetroAchievements, Steam and Xbox progress on one site you own">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <link rel="icon" href={base + 'assets/favicon.ico'} sizes="any">
    <link rel="icon" type="image/svg+xml" href={base + 'assets/favicon.svg'}>
    <link rel="apple-touch-icon" href={base + 'assets/icon-192.png'}>
    <link rel="sitemap" href={base + 'sitemap-index.xml'}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oxanium:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
    <script is:inline>document.documentElement.classList.add('js')</script>
    {ld.map(x => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    <slot name="head" />
</head>
<body>
<div class="sky" aria-hidden="true"><div class="glow a"></div><div class="glow b"></div><div class="glow c"></div><div class="glow d"></div><div class="glow e"></div></div>

<header class="nav">
    <div class="wrap">
        <a class="brand" href={base}><img src={base + 'assets/favicon.svg'} alt="" width="30" height="30">Savepoint</a>
        <nav class="nav-links" aria-label="Site">
            <a href={base + '#features'}>Features</a>
            <a href={base + '#demo'}>Live demo</a>
            <a href={base + '#how'}>How it works</a>
            <a href={base + 'docs/'} aria-current={section === 'docs' ? 'page' : undefined}>Docs</a>
        </nav>
        {section === 'docs'
            ? <a class="btn btn-primary btn-sm" href={TEMPLATE + '/generate'}>Use the template</a>
            : <a class="btn btn-ghost btn-sm" href={TEMPLATE}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
                GitHub
            </a>}
    </div>
</header>

<slot />

<footer class="footer">
    <div class="wrap">
        <a class="brand" href={base} style="font-size:17px"><img src={base + 'assets/favicon.svg'} alt="" width="24" height="24" style="width:24px;height:24px">Savepoint</a>
        <a href={base + 'docs/'}>Docs</a>
        <a href={TEMPLATE}>Template on GitHub</a>
        <a href={TEMPLATE + '/blob/main/LICENSE'}>MIT license</a>
        <p class="fine">Not affiliated with RetroAchievements, Valve, Microsoft or OpenXBL. Game names and art belong to their owners and load from the platforms' own servers.</p>
    </div>
</footer>

<script>
    // Small enhancements to static HTML: the nav line, scroll reveals, the light under the pointer, copy buttons
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nav = document.querySelector('.nav');
    const onScroll = () => nav?.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Each block fades up the first time it enters the screen
    const reveals = document.querySelectorAll('.reveal');
    if (reduced || !('IntersectionObserver' in window)) reveals.forEach(el => el.classList.add('in'));
    else {
        const io = new IntersectionObserver(entries => entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        reveals.forEach(el => io.observe(el));
    }

    document.querySelectorAll<HTMLElement>('.card').forEach(card => card.addEventListener('pointermove', e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
    }));

    // Every .codebox gets a button that copies its <pre> text
    // (islands render their own buttons)
    document.querySelectorAll('.codebox').forEach(box => {
        if (box.closest('astro-island')) return;
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'copy'; b.textContent = 'Copy';
        b.addEventListener('click', async () => {
            const text = (box.querySelector('pre') as HTMLElement).innerText.trim();
            try { await navigator.clipboard.writeText(text); }
            catch { const t = document.createElement('textarea'); t.value = text; document.body.append(t); t.select(); document.execCommand('copy'); t.remove(); }
            b.textContent = 'Copied'; b.classList.add('done');
            setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('done'); }, 1600);
        });
        box.append(b);
    });
</script>
</body>
</html>
